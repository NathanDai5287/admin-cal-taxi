# Host document-generation backend
HOST_BACKEND_ORIGIN=https://host-backend.example.com
# Shared bearer key the proxy sends to the backend (must match the backend's ADMIN_KEY)
HOST_BACKEND_KEY=replace_with_a_long_random_key

# Receipt reimbursements (Supabase + Tabscanner)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
# Google OAuth client ID (Google Cloud Console), used for One Tap sign-in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Public URL of the admin site, used for Discord review links and invite emails
NEXT_PUBLIC_SITE_URL=https://admin.cal.taxi
# Resend (invite emails). Default from-address works for tests; use a verified domain in production.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Theta Xi <invites@cal.taxi>
TABSCANNER_API_KEY=your_tabscanner_key

# Discord reimbursement review workflow
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_discord_channel_id
# Channel where admins send dues announcements
DISCORD_ANNOUNCEMENT_CHANNEL_ID=your_dues_announcement_channel_id
DISCORD_REVIEWER_ROLE_ID=your_optional_reviewer_role_id
REIMBURSEMENTS_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Accreditation reports. Set false to hide the pilot after deployment.
ACCREDITATION_ENABLED=true
# Server-only keys. The OpenAI adapter remains optional.
ACCREDITATION_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
ACCREDITATION_LLM_MODEL=gemini-3.8-flash
ACCREDITATION_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
ACCREDITATION_OCR_MODEL=gemini-3.8-flash
ACCREDITATION_EMBEDDING_MODEL=gemini-embedding-2
ACCREDITATION_EMBEDDING_DIMENSIONS=768
ACCREDITATION_EMBEDDING_PROFILE=gemini-embedding-2:768:retrieval-v1
# Enable only after migration, re-embedding, and retrieval verification.
ACCREDITATION_GEMINI_REPORTS_ENABLED=false
POLICY_ASSISTANT_ENABLED=false
# Administrator pilot first, then explicitly enable active members.
POLICY_ASSISTANT_MEMBERS_ENABLED=false
POLICY_QUESTIONS_PER_MINUTE=5
POLICY_QUESTIONS_PER_DAY=50
# IANA time zone used by the policy assistant's clock and calendar tools.
POLICY_TIME_ZONE=America/Los_Angeles

EMAIL_TRACKING_SECRET=
